{
  "name": "jvm-monitoring-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write 'src/**/*.ts'",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "migration:run": "npm run build && node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "migration:show": "npm run build && node ./node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "db:backup": "bash ./scripts/db-backup.sh",
    "db:restore": "bash ./scripts/db-restore.sh",
    "db:rehearsal": "bash ./scripts/db-rehearsal.sh",
    "perf:smoke": "k6 run ../docs/k6-ramp-scenarios.js -e PROFILE=smoke -e MODE=normal",
    "perf:ramp": "k6 run ../docs/k6-ramp-scenarios.js -e PROFILE=ramp -e MODE=normal",
    "perf:mixed": "k6 run ../docs/k6-ramp-scenarios.js -e PROFILE=ramp -e MODE=mixed",
    "perf:error": "k6 run ../docs/k6-ramp-scenarios.js -e PROFILE=ramp -e MODE=error -e ERROR_PATH=${ERROR_PATH:-/api/blocks/9999999999999999}",
    "perf:latency": "k6 run ../docs/k6-ramp-scenarios.js -e PROFILE=ramp -e MODE=latency -e LATENCY_PATH=${LATENCY_PATH:-/api/blocks?dashboardId=2&progress=NOT_STARTED}"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/config": "^3.0.0",
    "typeorm": "^0.3.17",
    "pg": "^8.11.3",
    "axios": "^1.5.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3"
  }
}
