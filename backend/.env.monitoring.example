# Prometheus endpoint
PROMETHEUS_URL=http://134.185.100.182:9090/api/v1/query

# 1) Target only the real service instance.
# Example: job="kkeujeok-api",instance="134.185.100.182:8080"
PROMETHEUS_TARGET_LABELS=job="kkeujeok-api"

# Optional per-domain label overrides. If omitted, PROMETHEUS_TARGET_LABELS is reused.
PROMETHEUS_PROCESS_LABELS=
PROMETHEUS_GC_LABELS=
PROMETHEUS_DB_LABELS=
PROMETHEUS_HTTP_LABELS=

# Optional query overrides if your metric names are different.
PROMETHEUS_HEAP_USED_QUERY=
PROMETHEUS_HEAP_MAX_QUERY=
PROMETHEUS_CPU_QUERY=
PROMETHEUS_GC_PAUSE_AVG_MS_QUERY=
PROMETHEUS_DB_ACTIVE_CONNECTIONS_QUERY=
PROMETHEUS_HTTP_METRIC=http_server_requests_seconds_count
PROMETHEUS_HTTP_2XX_RATE_QUERY=
PROMETHEUS_HTTP_4XX_RATE_QUERY=
PROMETHEUS_HTTP_5XX_RATE_QUERY=

# Monitoring behavior
JVM_HEAP_WARN_RATIO=0.8
JVM_HEAP_CRITICAL_RATIO=0.95
JVM_HEAP_MAX_FALLBACK_BYTES=2147483648
MONITORING_ALLOW_RANDOM_FALLBACK=false
# SLO (burn-rate evidence/queries)
# 99.9% SLO -> error budget ratio 0.001
SLO_ERROR_BUDGET_RATIO=0.001
