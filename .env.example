# Ports
FRONTEND_PORT=3001
BACKEND_PORT=3002

# Postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Ops / Alerting
# Encrypt cluster bearer tokens at rest (recommended; >=16 chars)
APP_SECRET=

# Public URL used in Discord alerts (View link).
# Example: https://aegis.example.com
OPS_PUBLIC_URL=http://localhost:3001

# Enable/disable alert evaluation loop
ALERT_ENGINE_ENABLED=true
ALERT_ENGINE_CONCURRENCY=3

# AI analysis (optional)
# AI_PROVIDER=none|ollama|openai
AI_PROVIDER=none
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
AI_OLLAMA_TIMEOUT_MS=20000
AI_OLLAMA_RETRIES=0
AI_OLLAMA_NUM_PREDICT=180
AI_PROVIDER_BACKOFF_BASE_MS=30000
AI_PROVIDER_BACKOFF_MAX_MS=300000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SLO_ERROR_BUDGET_RATIO=0.001

# Prometheus query endpoint (not scrape endpoint)
PROMETHEUS_URL=http://localhost:9090/api/v1/query
PROMETHEUS_TARGET_LABELS=

# Optional: node-exporter labels/queries for VM(instance) memory monitoring
# Example: PROMETHEUS_NODE_LABELS=job="node-exporter"
PROMETHEUS_NODE_LABELS=
PROMETHEUS_NODE_MEM_USED_QUERY=
PROMETHEUS_NODE_MEM_TOTAL_QUERY=
PROMETHEUS_NODE_MEM_AVAILABLE_QUERY=
PROMETHEUS_NODE_SWAP_USED_QUERY=
PROMETHEUS_NODE_SWAP_TOTAL_QUERY=
PROMETHEUS_NODE_LOAD1_QUERY=
INSTANCE_MEMORY_WARN_RATIO=0.85
INSTANCE_MEMORY_CRITICAL_RATIO=0.95
# Hysteresis clear thresholds to reduce status flapping near boundaries
INSTANCE_MEMORY_WARN_CLEAR_RATIO=0.83
INSTANCE_MEMORY_CRITICAL_CLEAR_RATIO=0.93
